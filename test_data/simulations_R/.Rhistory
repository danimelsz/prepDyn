# Plot: Cost vs Partitions, grouped by (n_leaves, n_columns), all data
df$group <- interaction(df$n_leaves, df$n_columns, drop = TRUE)
p <- ggplot(df, aes(x = n_partitions, y = cost, color = group)) +
geom_line(linewidth = 1, alpha = 0.7) +
geom_point(size = 2) +
# Add labels only to the last point of each group
geom_text_repel(
data = subset(df, n_partitions == max(n_partitions)),
aes(label = group),
size = 3,
nudge_x = 0.5,
direction = "y",
hjust = 0
) +
labs(
x = "No. partitions",
y = "Parsimony score",
color = "Leaves × Nucleotides"
) +
theme_classic() +
scale_color_viridis_d(option = "D", direction = -1) +
# Expand x-axis slightly to fit the labels
scale_x_continuous(expand = expansion(mult = c(0.05, 0.2))) +
theme(legend.position = "none") # Optional: remove legend if using direct labels
p
ggsave("simulations_noPartitionsXcostDO.jpg", p, width = 8, height = 5, dpi = 300, units = "in")
# 1. Prepare the data: Calculate the next point for each group
df_segments <- df %>%
arrange(group, n_partitions) %>%
group_by(group) %>%
mutate(
next_partitions = lead(n_partitions),
next_cost = lead(cost),
change = case_when(
next_cost > cost ~ "Increase",
next_cost < cost ~ "Decrease",
next_cost == cost ~ "No Change"
)
) %>%
filter(!is.na(next_partitions)) # Remove the last point of each group
library(ggplot2)
library(dplyr)
# 1. Prepare the data: Calculate the next point for each group
df_segments <- df %>%
arrange(group, n_partitions) %>%
group_by(group) %>%
mutate(
next_partitions = lead(n_partitions),
next_cost = lead(cost),
change = case_when(
next_cost > cost ~ "Increase",
next_cost < cost ~ "Decrease",
next_cost == cost ~ "No Change"
)
) %>%
filter(!is.na(next_partitions)) # Remove the last point of each group
# 2. Plot using geom_segment
p <- ggplot(df_segments) +
# Draw segments colored by the type of change
geom_segment(aes(x = n_partitions, y = cost,
xend = next_partitions, yend = next_cost,
color = change),
linewidth = 1.2, arrow = arrow(length = unit(0.2, "cm"))) +
# Add points on top
geom_point(aes(x = n_partitions, y = cost)) +
# Manual colors: Red for bad (increase), Blue/Green for good (decrease)
scale_color_manual(values = c("Increase" = "#d7191c",
"Decrease" = "#2c7bb6",
"No Change" = "gray70")) +
labs(
x = "No. partitions",
y = "Parsimony score",
color = "Successive Change"
) +
theme_classic()
p
