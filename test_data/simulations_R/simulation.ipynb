## Time complexity
### Tree simulation
To understand time complexity, I initially simulated three trees with different number of leaves (10, 20, 40). 
'''
import numpy as np
import pandas as pd
import ngesh
import os
import itertools

# Define function to randomly sample values of parameters of simulations using uniform distributions
def sample_phylo_parameters(
    leaves=[10, 20, 40],
    characters=[100, 1000, 10000]
):
    """
    Generate a dataframe of all combinations of number of leaves and characters.

    Parameters:
    - leaves (list): possible values for number of taxa
    - characters (list): possible values for number of alignment sites

    Returns:
    - pd.DataFrame with columns:
        - 'n_leaves': one of the values in `leaves`
        - 'n_characters': one of the values in `characters`
    """
    
    combinations = list(itertools.product(leaves, characters))
    df = pd.DataFrame(combinations, columns=["n_leaves", "n_characters"])
    
    return df

# Simulate parameters
simulations_parameters = sample_phylo_parameters(leaves=[10, 20, 40], 
                                                 characters=[0]) # ignore it
print(simulations_parameters)

# Define function to simulate trees from the values of column n_leaves
def simulate_and_save_trees(simulations_parameters, output_dir):
    os.makedirs(output_dir, exist_ok=True)

    for i, row in simulations_parameters.iterrows():
        n_leaves = row["n_leaves"]
        print(f"Generating tree with {n_leaves} leaves...")

        tree = ngesh.gen_tree(num_leaves=n_leaves, seed=44)
        newick = tree.write(format=5)

        filename = f"t{n_leaves}.nwk"
        file_path = os.path.join(output_dir, filename)

        with open(file_path, "w") as f:
            f.write(newick + "\n")

        print(f"Saved {filename}")

# Simulate trees
simulate_and_save_trees(simulations_parameters, output_dir="../test_data/simulations_v1/")
'''    
### Sequence simulation
The four trees are written locally. Now, I need to simulate DNA alignments based on these trees using IQ-TREE 3 (number of characters = 100, 1000, 10000), generating a combination of 12 data sets (4 x 3). 
'''
import os
import subprocess
import re
import shutil
import glob

def simulate_alignments_from_trees(
    tree_dir="../test_data/simulations_v1/",
    lengths=[100, 1000, 10000],
    model="JC",
    indel="0,0.0005",
    out_format="fasta",
    seed=44
):
    # Match files like t10.nwk, t20.nwk, etc.
    tree_files = [f for f in os.listdir(tree_dir) if re.match(r"t\d+\.nwk$", f)]
    tree_files.sort()

    for tree_file in tree_files:
        tree_path = os.path.join(tree_dir, tree_file)
        n_leaves = re.findall(r"t(\d+)\.nwk", tree_file)[0]  # extract 10, 20, 40...

        for length in lengths:
            prefix = f"t{n_leaves}_len{length}"
            alisim_arg = f"{prefix}.fasta"
            expected_output = f"{alisim_arg}.unaligned.fa"  # IQ-TREE's default output

            cmd = [
                "iqtree3",
                "--alisim", alisim_arg,
                "-m", model,
                "-t", tree_path,
                "--indel", indel,
                "--length", str(length),
                "--out-format", out_format,
                "-seed", str(seed)
            ]

            print("Running:", " ".join(cmd))
            result = subprocess.run(cmd, capture_output=True, text=True)

            if result.returncode != 0:
                print(f"Error for tree {tree_file} with length {length}:")
                print(result.stderr)
                continue

            if os.path.exists(expected_output):
                print(f"Success: {expected_output}")
            else:
                print(f"Output missing: {expected_output}")
                print(result.stdout)

# Run the simulation
simulate_alignments_from_trees()

# Organize output files
unaligned_dir = "../test_data/simulations_v1/1_unaligned"
aligned_dir = "../test_data/simulations_v1/2_aligned"
os.makedirs(unaligned_dir, exist_ok=True)
os.makedirs(aligned_dir, exist_ok=True)

# Move .fa files into the appropriate subdirectories
for file in glob.glob("*.fa"):
    if "unaligned" in file:
        dest_path = os.path.join(unaligned_dir, file)
    elif file.endswith("fasta.fa"):
        dest_path = os.path.join(aligned_dir, file)
    else:
        print(f"Skipped file (no match): {file}")
        continue

    shutil.move(file, dest_path)
    print(f"Moved {file} → {dest_path}")

# Rename *.fasta.fa → *.fasta for use in PrepDyn
for filepath in glob.glob(os.path.join(aligned_dir, "*fasta.fa")):
    new_filepath = filepath[:-3]  # remove the ".fa"
    os.rename(filepath, new_filepath)
    print(f"Renamed {filepath} → {new_filepath}")

