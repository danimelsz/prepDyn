'''
Now, let's create the PhyG scripts for each data set.
'''
# All target directories with their corresponding prep identifiers
directories = {
    "3.1_noPartition": "3.1",
    "3.2_elPartition1": "3.2",
    "3.3_elPartition2": "3.3",
    "3.4_elPartition4": "3.4",
    "3.5_elPartition8": "3.5",
    "3.6_elPartition16": "3.6",
    "3.7_elPartition32": "3.7",
    "3.8_elPartition64": "3.8"
}

# Root path
base_path = "../test_data/simulations_v1"

# Values to substitute
leaves_list = [10, 20, 40]
columns_list = [100, 1000, 10000]

# Script template
template = """set (seed:22)

--LOAD DATA
read ("{prep}_t{leaves}_len{columns}_preprocessed.fasta")

--SEARCH SETTINGS
set (partitioncharacter:#)
set (criterion:parsimony)
set (graphtype:tree)
build()
swap()

--REPORT RESULTS
report ("{prep}_t{leaves}_len{columns}_searchstats.csv", search) 
report ("{prep}_t{leaves}_len{columns}_searchTrees.nwk", graphs, newick, nohtulabels)
select (unique)
select (best)
report ("{prep}_t{leaves}_len{columns}_bestUnique.nwk", graphs, newick, nohtulabels)
report ("{prep}_t{leaves}_len{columns}_ia.tnt", tnt, concatenate, overwrite)
report ("{prep}_t{leaves}_len{columns}_bestConsensus.nwk", newick, reconcile, method:strict, nohtulabels)
"""

# Generate scripts for each directory
for dir_name, prep in directories.items():
    output_dir = os.path.join(base_path, dir_name)
    os.makedirs(output_dir, exist_ok=True)

    for leaves in leaves_list:
        for columns in columns_list:
            script_content = template.format(prep=prep, leaves=leaves, columns=columns)
            filename = f"{prep}_t{leaves}_len{columns}_script.pg"
            filepath = os.path.join(output_dir, filename)

            with open(filepath, "w") as f:
                f.write(script_content)

print("All .pg script files generated successfully.")
